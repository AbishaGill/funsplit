<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Offline banner — shown when ConnectivityManager reports no network -->
    <TextView
        android:id="@+id/banner_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC1D1B19"
        android:text="@string/offline_banner"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:visibility="gone"
        android:fontFamily="@font/dm_sans" />

    <!-- Top app bar: logo left, avatar right -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/color_primary"
                android:textSize="22sp"
                android:fontFamily="@font/dm_sans"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile avatar circle — shows initials, loads photo via Glide -->
            <TextView
                android:id="@+id/tv_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_avatar_orange"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/dm_sans"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable main content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <!-- Balance card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- My total -->
                    <TextView
                        android:id="@+id/tv_my_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_total_placeholder"
                        android:textColor="@color/color_primary_container"
                        android:textSize="32sp"
                        android:fontFamily="@font/dm_sans"
                        android:textStyle="bold" />

                    <!-- Partner total -->
                    <TextView
                        android:id="@+id/tv_partner_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/partner_total_placeholder"
                        android:textColor="@color/color_secondary"
                        android:textSize="20sp"
                        android:fontFamily="@font/dm_sans"
                        android:layout_marginTop="4dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_outline_variant"
                        android:layout_marginVertical="12dp" />

                    <!-- Net balance row -->
                    <LinearLayout
                        android:id="@+id/row_net_balance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_trend"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_trending_up"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_net_balance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/you_are_owed_placeholder"
                            android:textSize="14sp"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/color_tertiary"
                            android:layout_marginStart="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_settle_up"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="@string/settle_up"
                            android:textSize="12sp"
                            android:backgroundTint="@color/color_secondary_container"
                            android:textColor="@color/color_secondary"
                            app:cornerRadius="50dp"
                            android:paddingHorizontal="12dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent Expenses header with "See All" link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent_expenses"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/dm_sans"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textSize="13sp"
                    android:textColor="@color/color_primary_container"
                    android:fontFamily="@font/dm_sans"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Shimmer skeleton — inflated while Firestore loads, hidden once data arrives -->
            <ViewStub
                android:id="@+id/stub_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/layout_shimmer_skeleton"
                android:visibility="visible" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_expenses"
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:fontFamily="@font/dm_sans"
                android:gravity="center"
                android:paddingVertical="32dp"
                android:visibility="gone" />

            <!-- Expenses list — not a RecyclerView inside ScrollView, but
                 we wrap RecyclerView with nestedScrollingEnabled=false so
                 NestedScrollView drives the scroll. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_expenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/add_expense"
        app:backgroundTint="@color/color_primary_container"
        app:tint="@android:color/white"
        app:fabSize="normal" />

    <!-- Bottom navigation — 2 items -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/color_surface"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
