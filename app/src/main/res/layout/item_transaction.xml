<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- From avatar -->
        <TextView
            android:id="@+id/tv_avatar_from"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_orange"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/dm_sans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Arrow icon -->
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@null"
            app:layout_constraintStart_toEndOf="@id/tv_avatar_from"
            app:layout_constraintEnd_toStartOf="@id/tv_avatar_to"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="8dp" />

        <!-- To avatar -->
        <TextView
            android:id="@+id/tv_avatar_to"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_blue"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/dm_sans"
            app:layout_constraintStart_toEndOf="@id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- From label -->
        <TextView
            android:id="@+id/tv_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_avatar_from"
            app:layout_constraintStart_toStartOf="@id/tv_avatar_from"
            app:layout_constraintEnd_toEndOf="@id/tv_avatar_from"
            android:layout_marginTop="4dp" />

        <!-- To label -->
        <TextView
            android:id="@+id/tv_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_avatar_to"
            app:layout_constraintStart_toStartOf="@id/tv_avatar_to"
            app:layout_constraintEnd_toEndOf="@id/tv_avatar_to"
            android:layout_marginTop="4dp" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_settle_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_error"
            android:fontFamily="@font/dm_sans"
            app:layout_constraintEnd_toStartOf="@id/btn_mark_settled"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btn_mark_settled"
            android:layout_marginEnd="12dp" />

        <!-- Mark Settled button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_settled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mark_settled"
            android:textSize="13sp"
            android:backgroundTint="@color/color_primary_container"
            app:cornerRadius="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
