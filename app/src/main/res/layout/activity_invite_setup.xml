<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            android:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Headline -->
        <TextView
            android:id="@+id/tv_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/invite_headline"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/dm_sans"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back" />

        <!-- Name or email input with email icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_invite"
            style="@style/Widget.FinSplit.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/invite_hint"
            android:layout_marginTop="32dp"
            app:boxStrokeColor="@color/text_input_box_stroke"
            app:hintTextColor="@color/text_input_label"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/text_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_headline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_invite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:imeOptions="actionSend"
                android:fontFamily="@font/dm_sans" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send Invite filled pill -->
        <Button
            android:id="@+id/btn_send_invite"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/send_invite"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:fontFamily="@font/dm_sans"
            android:background="@drawable/bg_pill_filled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_invite" />

        <!-- OR divider -->
        <LinearLayout
            android:id="@+id/row_or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_send_invite">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/or"
                android:textSize="13sp"
                android:textColor="@color/text_hint"
                android:fontFamily="@font/dm_sans"
                android:paddingHorizontal="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_outline_variant" />

        </LinearLayout>

        <!-- Share link outlined pill -->
        <Button
            android:id="@+id/btn_share_link"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/share_link"
            android:textColor="@color/color_primary"
            android:textSize="15sp"
            android:fontFamily="@font/dm_sans"
            app:cornerRadius="28dp"
            app:strokeColor="@color/color_primary"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/color_primary"
            app:iconGravity="textStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/row_or" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/color_primary_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_share_link"
            android:layout_marginTop="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
