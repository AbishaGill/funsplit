<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FinSplit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>
        <item name="colorOnTertiary">@color/color_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/color_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>

        <!-- Background / surface -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_outline_variant</item>

        <!-- Shape: pill buttons, rounded cards -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FinSplit.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FinSplit.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.FinSplit.LargeComponent</item>
    </style>

    <!-- Splash screen — full background, no action bar -->
    <style name="Theme.FinSplit.Splash" parent="Theme.FinSplit">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Shape appearances -->
    <style name="ShapeAppearance.FinSplit.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.FinSplit.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.FinSplit.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- FAB style -->
    <style name="Widget.FinSplit.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/color_primary_container</item>
        <item name="tint">@android:color/white</item>
    </style>

    <!-- BottomSheetDialog: 28dp top corners, white background -->
    <style name="Theme.FinSplit.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FinSplit.BottomSheet</item>
    </style>

    <style name="Widget.FinSplit.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.FinSplit.BottomSheetShape</item>
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="ShapeAppearance.FinSplit.BottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- TextInputLayout: outlined, orange focused border -->
    <style name="Widget.FinSplit.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="hintTextColor">@color/text_input_label</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

</resources>
